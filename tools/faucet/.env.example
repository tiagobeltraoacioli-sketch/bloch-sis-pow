# ── Bloch testnet faucet — example configuration ──────────────────────────────
# Copy to `.env` and adjust. NEVER commit real secrets. Testnet-only.
# Test BLCH has NO value; this faucet dispenses coins on a zero-security testnet.

# JSON-RPC endpoint of a Bloch Genesis-4 node. The hosted testnet's nodes bind
# 18500-18503 (see deploy/testnet/HOSTED-TESTNET.md); never point this at a
# node's unauthenticated RPC over a public interface — front it.
FAUCET_RPC_URL=http://127.0.0.1:18500/

# Optional shared-secret for write methods (sent as X-API-Key). Leave empty on localhost.
FAUCET_RPC_API_KEY=

# ── WHO PAYS, AND ON WHICH CHAIN ─────────────────────────────────────────────
#
# Genesis-4 identifies a payer/payee by a 32-byte `script_hash`, NEVER by an
# address. The faucet's funding key is a native Genesis-4 key, and a native key
# has no address form at all: its script_hash is SHA3-256(hybrid pubkey), all
# 32 bytes, and 32 bytes do not fit in a bloch1t… body.
#
# The retired FAUCET_FUNDING_ADDRESS / FAUCET_CHANGE_ADDRESS are now REFUSED at
# startup rather than reinterpreted. Converting an address to a script_hash by
# zero-extending its 20 bytes yields a DIFFERENT key in the eUTXO set, so the
# faucet would have queried a hash that owns nothing and reported an empty
# wallet — or, worse, paid a requester at a hash they never asked for.
#
# Get the value from the faucet keystore:
#     bloch-pos spendkey --dir <t4dir>/faucet     # the `script_hash` line
FAUCET_FUNDING_SCRIPT_HASH=

# Where change goes (defaults to FAUCET_FUNDING_SCRIPT_HASH). 64 hex.
FAUCET_CHANGE_SCRIPT_HASH=

# THE NETWORK BINDING. The genesis block id of the chain this faucet is allowed
# to spend on, 64 hex:
#     curl -s -X POST $FAUCET_RPC_URL -H 'content-type: application/json' \
#       -d '{"jsonrpc":"2.0","id":1,"method":"getblockbyslot","params":[0]}' \
#       | python3 -c 'import json,sys; print(json.load(sys.stdin)["result"]["block_id"])'
#
# Required in LIVE mode. The service refuses to start if the node at
# FAUCET_RPC_URL reports a different genesis — a repointed URL, a reset testnet
# and a mainnet endpoint all fail closed. This replaced a bloch1t… prefix check
# on the funding string, which checked a string in isolation and therefore
# proved nothing about the node at the other end of the socket.
FAUCET_EXPECT_GENESIS_BLOCK_ID=

# Amount of test BLCH dispensed per request, in satoshis (1 BLCH = 1e8 sat).
FAUCET_AMOUNT_SATS=100000000

# Flat fee to attach, in satoshis.
FAUCET_FEE_SATS=1000

# HTTP listen host/port for the faucet web form + JSON API.
FAUCET_HOST=127.0.0.1
FAUCET_PORT=8080

# ── SIGNING SEAM (do NOT hardcode keys) ───────────────────────────────────────
# The faucet never holds the private key itself. It builds an unsigned payment
# "job" and hands it to an external signer command that owns the key material
# (e.g. the reference `bloch-wallet` / WalletCore, which knows the hybrid
# Falcon-1024 ‖ ML-DSA-65 signing + stratum serialisation).
#
# The command receives the job as JSON on stdin and must print the signed raw
# transaction hex on stdout (see README "Signing setup").
#
# Leave empty to run the faucet in DRY-RUN mode (no real signing/broadcast).
FAUCET_SIGNER_CMD=

# Master switch. When true (the default), the faucet uses stub RPC + stub signer
# and NEVER broadcasts. Set to false only against a real testnet node + signer.
FAUCET_DRY_RUN=true

# ── Rate limiting ─────────────────────────────────────────────────────────────
# One drip per address per this window (ms). Default 24h.
FAUCET_PER_ADDRESS_WINDOW_MS=86400000
# Max requests per client IP per window.
FAUCET_PER_IP_WINDOW_MS=3600000
FAUCET_PER_IP_MAX=5

# ── Drain protection (added with the reserve/commit limiter) ────────────────
# Ceiling on TOTAL payouts across all requesters in a rolling window. The
# per-address and per-IP limits bound ONE client; nothing bounded the sum of
# them, and anyone with a routed IPv6 /64 has 2^64 distinct per-IP keys.
# Default: 500 BLCH per 24 h.
FAUCET_GLOBAL_WINDOW_MS=86400000
FAUCET_GLOBAL_MAX_SATS=50000000000

# Trust CF-Connecting-IP / X-Forwarded-For from the proxy in front of this
# service. Set to 1 ONLY when the service is unreachable except through that
# proxy — otherwise every client can forge its own rate-limit key.
FAUCET_TRUST_PROXY=0
