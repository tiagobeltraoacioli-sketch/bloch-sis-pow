# ── Bloch reorg-safe indexer — example configuration ──────────────────────────
# Copy to `.env` and adjust. Reference tool; testnet-only by default.

# JSON-RPC endpoint of a Bloch node (default node RPC port is 16210).
INDEXER_RPC_URL=http://127.0.0.1:16210/

# Optional shared-secret for the node (sent as X-API-Key). Reads are public;
# usually not needed.
INDEXER_RPC_API_KEY=

# Which address network the on-chain 20-byte hashes should be encoded as when
# indexing (testnet => bloch1t…, mainnet => bloch1q…). Default testnet.
INDEXER_NETWORK=testnet

# Path to the embedded JSON store file.
INDEXER_DATA_FILE=./data/indexer-data.json

# Poll interval for the sync loop, in milliseconds.
INDEXER_POLL_MS=3000

# Read-API listen host/port.
INDEXER_API_HOST=127.0.0.1
INDEXER_API_PORT=8081

# Run against the built-in offline stub chain (which scripts a reorg) instead of
# a real node. Lets you see reorg handling with no node. Default false.
INDEXER_STUB=false
